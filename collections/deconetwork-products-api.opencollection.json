{
  "opencollection": "1.0.0",
  "info": {
    "name": "DecoNetwork JSON Inventory Products API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "username",
      "value": "{{username}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search products",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.deconetwork.com/api/json/manage_products/find",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Search products based on multiple conditions joined with logical AND. Returns up to 100 results per request with offset pagination and ISO-8601 UTC date filtering."
        },
        {
          "info": {
            "name": "Get products by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.deconetwork.com/api/json/manage_products/get",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "query"
              },
              {
                "name": "password",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a single product or multiple products by ID."
        }
      ]
    }
  ],
  "bundled": true
}